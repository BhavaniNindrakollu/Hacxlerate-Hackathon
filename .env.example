# ImpostorRadar environment template (copy to .env and adjust).
# Never commit the real .env file or real credentials.

# --- App ---
APP_NAME=ImpostorRadar
# development | production  (production enables Secure cookies by default)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Relative paths resolve against backend/. Use an absolute path for a persistent location.
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./impostorradar.db
# Hosted Postgres (e.g. Supabase free tier — survives redeploys, no code changes needed):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require


# --- Storage locations (configurable) ---
# Uploaded logos live here (relative paths resolve against backend/).
UPLOAD_DIR=uploads
# Bundled sample/seed datasets.
DATA_DIR=app/data
# Backup files written before destructive operations (JSON export + SQLite snapshot).
BACKUP_DIR=backups

# --- Security / sessions ---
# Comma-separated allowed browser origins. "*" entries are ignored (credentials are used, so wildcards are unsafe).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:8000,http://127.0.0.1:8000
# Session lifetime in hours (cookie + server-side session expiry).
SESSION_HOURS=12
# Force Secure attribute on cookies. Leave unset to auto-enable when ENVIRONMENT=production.
# COOKIE_SECURE=true
# SameSite for session/CSRF cookies. Keep "lax" for same-origin (frontend and API on
# one host). For split deployments (Vercel frontend -> Render backend) the browser
# treats the API as cross-site, so set COOKIE_SAMESITE=none (Secure is then required,
# which production enables automatically).
# COOKIE_SAMESITE=none
# Allow public self-registration. Set to false for a locked-down deployment.
ALLOW_SIGNUP=true
# Role granted to self-registered users (administrator is never allowed here).
DEFAULT_SIGNUP_ROLE=analyst
# Optional first-admin bootstrap, applied only while the users table is empty.
# Leave blank to make the first registered user the administrator.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Detection engine ---
# sample | live  — live connectors fall back to the bundled sample datasets when unavailable.
CONNECTOR_MODE=sample
